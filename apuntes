public class Main {

    static class Nodo {
        int info;
        Nodo izq;
        Nodo der;

        public Nodo(int info) {
            this.info = info;
            this.izq = null;
            this.der = null;
        }
    }

    static class ArbolBinario {
        Nodo raiz;

        public ArbolBinario() {
            raiz = null;
        }

        public void insertar(int info) {
            Nodo nuevo = new Nodo(info);

            if (raiz == null) {
                raiz = nuevo;
                return;
            }

            Nodo actual = raiz;
            Nodo padre = null;

            while (actual != null) {
                padre = actual;

                if (info < actual.info) {
                    actual = actual.izq;
                } else {
                    actual = actual.der;
                }
            }

            if (info < padre.info) {
                padre.izq = nuevo;
            } else {
                padre.der = nuevo;
            }
        }

        public void inorden(Nodo nodo) {
            if (nodo != null) {
                inorden(nodo.izq);
                System.out.print(nodo.info + " ");
                inorden(nodo.der);
            }
        }
    }

    public static void main(String[] args) {

        ArbolBinario arbol = new ArbolBinario();

        int[] valores = {8, 3, 10, 1, 6, 14, 4, 7, 13};

        for (int valor : valores) {
            arbol.insertar(valor);
        }

        arbol.inorden(arbol.raiz);

        // Resultado:
        // 1 3 4 6 7 8 10 13 14
    }
}
